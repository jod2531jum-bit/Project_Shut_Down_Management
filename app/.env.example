# Copy to .env (next to docker-compose.yml) and fill in. .env is git-ignored.
# On Cloud Run set these as service environment variables / secrets instead.

# none = open, no sign-in (local trials only). entra = Microsoft 365 sign-in.
AUTH_MODE=none

# Required when AUTH_MODE=entra (see docs/DEPLOYMENT.md)
ENTRA_TENANT_ID=
ENTRA_API_CLIENT_ID=
ENTRA_SPA_CLIENT_ID=
# Optional comma-separated Entra group object ids
ENTRA_GROUP_IMPORTER=
ENTRA_GROUP_EDITOR=
ENTRA_GROUP_VIEWER=

# true only when served over https (enables HSTS)
TLS=false

# Server settings (defaults are set in the Dockerfile; Cloud Run injects PORT)
# PORT=8080
# HOST=0.0.0.0
# DB_PATH=/data/shutdown.db
# STATIC_DIR=
# CORS_ORIGIN=
